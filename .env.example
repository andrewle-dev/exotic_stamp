# ExoticStamp root Compose / local development environment template.
# Copy to `.env` and adjust. NEVER commit real production secrets.
#
# If you already have volume `exoticstamp_postgres_data` initialized with a
# different POSTGRES_USER / POSTGRES_PASSWORD, keep those values — Postgres
# only applies POSTGRES_* on first init.

COMPOSE_PROJECT_NAME=exoticstamp

POSTGRES_DB=exotic_stamp
POSTGRES_USER=exotic_stamp
POSTGRES_PASSWORD=change_me
# Use 5432 when free; if a native PostgreSQL already owns 5432, set 5433 (or another free port).
POSTGRES_PORT=5432

REDIS_PASSWORD=change_me
REDIS_PORT=6379

BACKEND_PORT=8080

# Host-mode Spring Boot (Cursor / mvnw). Docker `full` profile overrides hosts.
# Host port in JDBC URL must match POSTGRES_PORT.
DB_URL=jdbc:postgresql://localhost:5432/exotic_stamp
DB_USERNAME=exotic_stamp
DB_PASSWORD=change_me

REDIS_HOST=localhost

STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=D:/Part-time/ExoticStamp/backend/uploads
STORAGE_LOCAL_URL=http://localhost:8080/uploads

# Required by backend at runtime (dev placeholder — replace for shared environments)
JWT_SECRET=local-dev-jwt-secret-must-be-at-least-256-bits-long

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ADMIN_SEED_PASSWORD=changeme-dev-only

# Mobile app config / version policy (backend GET /api/v1/mobile/app-config)
MOBILE_ANDROID_MIN_VERSION=0.1.0
MOBILE_ANDROID_LATEST_VERSION=0.1.0
MOBILE_ANDROID_FORCE_UPDATE=false
MOBILE_ANDROID_STORE_URL=
MOBILE_IOS_MIN_VERSION=0.1.0
MOBILE_IOS_LATEST_VERSION=0.1.0
MOBILE_IOS_FORCE_UPDATE=false
MOBILE_IOS_STORE_URL=
MOBILE_MAINTENANCE_ENABLED=false
MOBILE_MAINTENANCE_MESSAGE=
