# Prod-like compose secrets (copy to .env.prod-like — gitignored).
# Placeholders only — never commit real values.
# Loaded by docker-compose.prod-like.yml via env_file (Spring does not read .env alone).

DOMAIN=api.example.com
APP_ENV=local-prod-like
SPRING_PROFILES_ACTIVE=prod

JWT_SECRET=replace-with-openssl-rand-base64-32
RATE_LIMIT_KEY_PEPPER=replace-with-random-pepper-min-32-chars

DB_HOST=postgres
DB_PORT=5432
DB_NAME=exotic_stamp
DB_USERNAME=exotic_app
DB_PASSWORD=replace-me
DB_URL=jdbc:postgresql://postgres:5432/exotic_stamp

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-me

FRONTEND_URL=https://admin.example.com
BACKEND_URL=https://api.example.com
CORS_ALLOWED_ORIGINS=https://admin.example.com

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=replace-me
MAIL_FROM=noreply@example.com
MAIL_LOGO_URL=https://cdn.example.com/logo.png

STORAGE_PROVIDER=s3
AWS_REGION=ap-southeast-1
# Staging-style placeholder name (do not reuse production bucket names)
AWS_S3_BUCKET=exotic-stamp-staging-assets
STORAGE_PUBLIC_BASE_URL=https://cdn.example.com

# Lightsail: prefer instance role / temporary credentials over static keys.
# If using LocalStack profile (local-s3):
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
# AWS_S3_ENDPOINT=http://localstack:4566
# AWS_S3_PATH_STYLE=true

# Optional JVM override for co-located staging RAM tiers:
# JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=60.0
# SERVER_SHUTDOWN_TIMEOUT=30s

STORAGE_ORPHAN_RETENTION=14d
STORAGE_CLEANUP_BATCH_SIZE=50
STORAGE_CLEANUP_MAX_DURATION=30s
STORAGE_CLEANUP_DRY_RUN=false
STORAGE_CLEANUP_CRON=0 15 3 * * *
