# Staging Caddyfile example — placeholder domain only.
# Validate: docker run --rm -v "$PWD/infra/caddy/Caddyfile.staging.example:/etc/caddy/Caddyfile:ro" caddy:2.8-alpine caddy validate --config /etc/caddy/Caddyfile
# No real certificates or DNS credentials in git.

{$DOMAIN} {
	encode gzip

	request_body {
		max_size 8MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}

	@swagger {
		path /swagger-ui /swagger-ui/* /v3/api-docs /v3/api-docs/* /swagger-resources /swagger-resources/*
	}
	respond @swagger 404

	handle /actuator/health/readiness {
		reverse_proxy backend:8080 {
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
			transport http {
				read_timeout 10s
				write_timeout 10s
				dial_timeout 5s
			}
		}
	}

	handle /actuator/health/liveness {
		reverse_proxy backend:8080 {
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
			transport http {
				read_timeout 10s
				write_timeout 10s
				dial_timeout 5s
			}
		}
	}

	handle /api/* {
		reverse_proxy backend:8080 {
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
			transport http {
				read_timeout 60s
				write_timeout 60s
				dial_timeout 5s
			}
		}
	}

	@actuator_block {
		path /actuator /actuator/*
		not path /actuator/health/readiness
		not path /actuator/health/liveness
	}
	respond @actuator_block 404

	respond 404

	log {
		output stdout
		format json
	}
}
