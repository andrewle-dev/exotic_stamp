# Exotic Stamp Backend — Environment Variables (example)
# Copy to .env and fill in values. NEVER commit real secrets.

# --- Runtime profile ---
# Use "dev" locally, "prod" in production/staging runtime.
# Spring Boot does NOT auto-load this file — inject via IDE run config,
# Docker Compose env_file, systemd EnvironmentFile, or process environment.
SPRING_PROFILES_ACTIVE=dev
# Ops/script tag (not a Spring binding): local | staging | production
APP_ENV=local

# --- JWT (required) ---
# Generate with: openssl rand -base64 32
# Must be Base64 (standard or URL-safe) decoding to >= 32 bytes.
JWT_SECRET=replace-with-openssl-rand-base64-32

# --- Rate limit (required in prod; recommended locally) ---
RATE_LIMIT_KEY_PEPPER=replace-with-random-pepper-min-32-chars

# --- PostgreSQL (required) ---
# Prefer DB_URL for the app. DB_HOST/PORT/NAME are for ops scripts (preflight/backup).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=exotic_stamp
DB_URL=jdbc:postgresql://localhost:5432/exotic_stamp
DB_USERNAME=postgres
DB_PASSWORD=replace-me
# Topology-dependent: prefer|require|verify-full (embed in DB_URL or ops policy)
# DB_SSL_MODE=prefer

# --- Redis (required at runtime for auth OTP/refresh/revocation cache) ---
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave empty for local Redis without requirepass; set a strong secret when Redis auth is enabled.
REDIS_PASSWORD=
# REDIS_SSL=false
SERVER_PORT=8080
# SERVER_SHUTDOWN_TIMEOUT=30s
# JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0

# --- Mail (required for verification/OTP in non-test environments) ---
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=replace-me
MAIL_FROM=noreply@example.com
MAIL_DISPLAY_NAME=Exotic Travelers
MAIL_REPLY_TO=
MAIL_LIST_UNSUBSCRIBE=
MAIL_LOGO_URL=https://cdn.example.com/logo.png

# --- CORS (production: set explicitly; no localhost defaults in prod profile) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS,HEAD
CORS_ALLOWED_HEADERS=*
CORS_ALLOW_CREDENTIALS=true

# --- Production URLs (prod profile) ---
FRONTEND_URL=https://app.example.com
BACKEND_URL=https://api.example.com

# --- Local file storage / S3 ---
# STORAGE_PROVIDER: local (dev) | s3 (required in prod)
STORAGE_PROVIDER=local
# Use a portable path. Production rejects local filesystem provider.
STORAGE_LOCAL_PATH=./uploads
STORAGE_LOCAL_URL=http://localhost:8080/uploads
STORAGE_FILE_MAX_SIZE_MB=5
STORAGE_MULTIPART_MAX_FILE_SIZE=5MB
STORAGE_MULTIPART_MAX_REQUEST_SIZE=6MB

# --- S3 (required when STORAGE_PROVIDER=s3 / production) ---
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=exotic-stamp-media
# Public media base without trailing slash: public URL = base + "/" + object_key
STORAGE_PUBLIC_BASE_URL=https://cdn.example.com
# Optional LocalStack / custom endpoint only (never required for real AWS):
# AWS_S3_ENDPOINT=http://localhost:4566
# AWS_S3_PATH_STYLE=true
#
# Lightsail credential decision:
# Prefer the instance IAM role / temporary credentials via the AWS default provider chain.
# Do NOT put long-lived AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in compose YAML or git.
# Static keys are acceptable only via a secret manager / encrypted env delivery for break-glass.

# --- Orphan cleanup (optional overrides) ---
STORAGE_ORPHAN_RETENTION=14d
STORAGE_CLEANUP_BATCH_SIZE=50
STORAGE_CLEANUP_MAX_DURATION=30s
STORAGE_CLEANUP_DRY_RUN=false
STORAGE_CLEANUP_CRON=0 15 3 * * *
# --- DEV ONLY: seed passwords (required when SPRING_PROFILES_ACTIVE=dev) ---
ADMIN_SEED_PASSWORD=replace-dev-admin-password
DEMO_USER_PASSWORD=replace-dev-demo-password

# --- Mobile app config / version policy (optional overrides) ---
MOBILE_ANDROID_MIN_VERSION=0.1.0
MOBILE_ANDROID_LATEST_VERSION=0.1.0
MOBILE_ANDROID_FORCE_UPDATE=false
MOBILE_ANDROID_STORE_URL=
MOBILE_IOS_MIN_VERSION=0.1.0
MOBILE_IOS_LATEST_VERSION=0.1.0
MOBILE_IOS_FORCE_UPDATE=false
MOBILE_IOS_STORE_URL=
MOBILE_MAINTENANCE_ENABLED=false
MOBILE_MAINTENANCE_MESSAGE=

# --- Production notes ---
# - Swagger/OpenAPI disabled in application-prod.yml.
# - Set CORS_ALLOWED_ORIGINS to your admin/web origins only.
# - CI must run Docker for Testcontainers (see docs/CI_TEST_REQUIREMENTS.md).
