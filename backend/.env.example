# Exotic Stamp Backend — Environment Variables (example)
# Copy to .env and fill in values. NEVER commit real secrets.

# --- Runtime profile ---
# Use "dev" locally, "prod" in production.
SPRING_PROFILES_ACTIVE=dev

# --- JWT (required) ---
# Must be at least 256 bits for HMAC-SHA. Use a long random string in real deployments.
JWT_SECRET=replace-with-at-least-32-characters-random-secret

# --- PostgreSQL (required) ---
# Application reads spring.datasource.* from these env vars (see application.yml).
DB_URL=jdbc:postgresql://localhost:5432/exotic_stamp
DB_USERNAME=postgres
DB_PASSWORD=replace-me

# --- Redis (required at runtime for auth OTP/refresh/revocation cache) ---
REDIS_HOST=localhost
REDIS_PORT=6379
# Must match docker-compose REDIS_PASSWORD when Redis requirepass is enabled.
REDIS_PASSWORD=change_me
SERVER_PORT=8080

# --- Mail (required for verification/OTP in non-test environments) ---
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=replace-me
MAIL_FROM=noreply@example.com
# Friendly sender name shown next to the From address (avoids Gmail showing the raw local-part).
MAIL_DISPLAY_NAME=Exotic Travelers
# Optional: set to a monitored inbox to receive replies; leave blank to fall back to MAIL_FROM.
MAIL_REPLY_TO=
# Optional: one-click unsubscribe header value, only if marketing-adjacent mail is sent.
# Example: <mailto:unsubscribe@example.com>, <https://app.example.com/unsubscribe>
MAIL_LIST_UNSUBSCRIBE=

# --- CORS (production: set explicitly; no localhost defaults in prod profile) ---
# Comma-separated list of allowed browser origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS,HEAD
CORS_ALLOWED_HEADERS=*
CORS_ALLOW_CREDENTIALS=true

# --- Production URLs (prod profile) ---
FRONTEND_URL=https://app.example.com
BACKEND_URL=https://api.example.com

# --- Local file storage ---
# STORAGE_PROVIDER: local | s3 (s3 not implemented yet)
STORAGE_PROVIDER=local
# Absolute path recommended on Windows (forward slashes). Relative paths are resolved
# to an absolute path at startup — never rely on Tomcat's working directory.
STORAGE_LOCAL_PATH=D:/Part-time/ExoticStamp/backend/uploads
STORAGE_LOCAL_URL=http://localhost:8080/uploads
STORAGE_FILE_MAX_SIZE_MB=5
STORAGE_MULTIPART_MAX_FILE_SIZE=5MB
STORAGE_MULTIPART_MAX_REQUEST_SIZE=6MB

# --- Auth token revocation (optional override) ---
# Default in application.yml: false (fail-closed on DB error during token_version check).
# Dev profile sets true in application-dev.yml for local resilience.
# APPLICATION_SECURITY_TOKEN_REVOCATION_FAIL_OPEN_ON_DB_ERROR=false

# --- Auth OTP / verification (optional overrides; see application.yml application.auth.*) ---
# APPLICATION_AUTH_OTP_LENGTH=6
# APPLICATION_AUTH_OTP_TTL=5m
# APPLICATION_AUTH_OTP_COOLDOWN_TTL=2m
# APPLICATION_AUTH_OTP_ATTEMPTS_TTL=1h
# APPLICATION_AUTH_OTP_MAX_ATTEMPTS=5
# APPLICATION_AUTH_VERIFICATION_TOKEN_TTL=15m
# APPLICATION_AUTH_VERIFICATION_RESEND_COOLDOWN_TTL=2m
# Redis unavailable behavior: docs/AUTH_REDIS_UNAVAILABLE_BEHAVIOR.md

# --- DEV ONLY: admin seed bootstrap (AdminSeedBootstrap @Profile dev) ---
ADMIN_SEED_PASSWORD=changeme-dev-only

# --- Mobile app config / version policy (optional overrides; see application.yml mobile.app-config.*) ---
# Public GET /api/v1/mobile/app-config — update & maintenance policy only (not installed binary version).
MOBILE_ANDROID_MIN_VERSION=0.1.0
MOBILE_ANDROID_LATEST_VERSION=0.1.0
MOBILE_ANDROID_FORCE_UPDATE=false
MOBILE_ANDROID_STORE_URL=
MOBILE_IOS_MIN_VERSION=0.1.0
MOBILE_IOS_LATEST_VERSION=0.1.0
MOBILE_IOS_FORCE_UPDATE=false
MOBILE_IOS_STORE_URL=
MOBILE_MAINTENANCE_ENABLED=false
MOBILE_MAINTENANCE_MESSAGE=

# --- Production notes ---
# - Swagger/OpenAPI disabled in application-prod.yml (springdoc.api-docs.enabled=false).
# - Set CORS_ALLOWED_ORIGINS to your Flutter/web app origin(s) only.
# - CI must run Docker for Testcontainers integration tests (see docs/CI_TEST_REQUIREMENTS.md).
